# Python
__pycache__/
*.pyc
.pytest_cache/

# Model weights & checkpoints (too large for git, regenerated by the code)
*.pt
*.pth
models/

# Data (lives outside the repo)
data/
augmented/
runs/
.nndl_python

# The run results are copied into the repository under results/runs/, so
# that a reader can check a number against the file it came from.  The
# pattern above matches any directory called "runs" at any depth, so
# this one has to be taken back explicitly.
!results/runs/
!results/runs/**

# LaTeX build artifacts
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.toc

# OS
.DS_Store
Thumbs.db

# Local PDF build / review artifacts
/tmp/pdfs/
/output/pdf/

# The compiled report is a build artifact: it is regenerated by
#   cd report && pdflatex final_report.tex && bibtex final_report && pdflatex final_report.tex
# and the sources under report/ are the tracked version of it.
#
# The PDF is kept as well, so that a reader can look at the report
# without installing a LaTeX toolchain.  It is regenerated whenever the
# sources change.
report/progress_report.pdf

# The handoff zip is a duplicate of handoff_member5/ that is already tracked
member3_handoff_member5.zip

# Scratch space used during development
/_dl/
/_dl/
_tmp.json

# Editor / OS noise
.vscode/
.idea/
*.swp
